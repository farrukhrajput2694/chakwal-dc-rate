# Copy to .env and adjust. Every value here is optional -- the app runs with
# none of them set, which is how it behaves on a laptop.
#
# These are the only environment variables the app itself reads. The listen
# address and worker count are set on the uvicorn command line, because they
# have to be: see the Dockerfile CMD, the Procfile, and docker-compose.yml.

# When the nightly reference refresh runs, as a wall-clock time in PAKISTAN time.
#
# You do not need to change this for a hosted container. The scheduler anchors
# the time on the Pakistan clock and converts to the host's own, so 00:00 here
# means midnight in Chakwal whether the app is running on a Pakistan laptop or
# on a Render container sitting on UTC.
#
# (An earlier version of this file said the hour was the host's local time and
# suggested setting it to 5 on a UTC host. Both halves were wrong: 5 UTC is
# 10am in Chakwal, and midnight in Chakwal is 19 UTC, not 5. The scheduler now
# takes the zone itself, so leave these at 0 unless you want a different hour.)
RATE_APP_REFRESH_HOUR=0
RATE_APP_REFRESH_MINUTE=0

# Leave blank. The page and the API are served from the same origin, so CORS is
# not needed. Setting this opens the API to whatever origin you list, so only do
# it if you have deliberately split the frontend onto another host.
RATE_APP_CORS_ORIGINS=
