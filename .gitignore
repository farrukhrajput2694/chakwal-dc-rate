# Python bytecode, regenerated on every run. Never committed: the files are
# machine-specific and a stale .pyc can shadow an edited source file.
__pycache__/
*.py[cod]

# Virtualenv. 32 MB, 2,000+ files, and rebuilt with:
#   python -m venv .venv
#   .venv\Scripts\pip install -r requirements.txt
.venv/
venv/

# Local lookup history. Runtime state, not source. Nothing writes to it
# any more -- the endpoints answer empty -- but it is not worth versioning.
history.db
*.db

# Local environment overrides. .env.example is the committed template.
.env

# PyInstaller output for the Windows desktop app. 42 MB and 404 files, all of
# it regenerated by:
#   .venv\Scripts\pyinstaller.exe desktop\build.spec --noconfirm --clean
# The spec and the sources under desktop/ are the things worth versioning.
dist/
build/
desktop/web/desktop-error.log
desktop/web/desktop.log

# The desktop app's own runtime files, should it ever be run from source.
desktop-url.txt
desktop-routes.txt
desktop-error.log
desktop.log

# Local server output. start-server.ps1 and the ChakwalDCServer scheduled task
# both write here on every boot, so these are machine state rather than source,
# and committing them would rewrite tracked files on every start.
logs/

# Scratch copies made while comparing deployments by hand. Not a variant of the
# site -- they drifted from static/ and keeping them invites editing the wrong
# file.
_loose-copies/

# TLS material, as a backstop. The VPS deployment keeps Caddy's certificates in
# /opt/chakwal/data, outside this repository, so nothing here should ever match.
# It is listed because a private key must never reach GitHub even once, and a
# leaked key cannot be un-leaked by deleting the file afterwards.
*.pem
*.crt
*.key
caddy*

# The Visual C++ redistributable that the Windows 7 build downloads and bundles
# into its installer. 24 MB of Microsoft binary, not ours, and not reproducible
# from anything in this repository. The Inno Setup script fetches it instead.
# Matched at any depth: there is a copy in desktop/win7/ and another in
# desktop/win7/prereq/, and a path-specific rule only caught the first one.
desktop/win7/**/*.exe

# DuckDNS updater state. Holds the public IP it last pushed, which is
# not secret but is machine state and changes every time the IP changes.
duckdns.lastip
