{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "venv/**",
        ".venv/**",
        "__pycache__/**",
        "*.pyc",
        ".git/**",
        "**/.DS_Store"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "/static/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/health",
        "function": "api"
      }
    ]
  }
}
